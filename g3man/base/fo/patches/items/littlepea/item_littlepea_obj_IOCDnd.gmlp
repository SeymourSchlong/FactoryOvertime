meta:
targets = 'gml_Object_obj_IOCDnd_Step_0'
critical = true

patch:
find_line_with('scr_TonyEmote("HeadSwivel", 1, 0)')

write_before('
var _reg_obj = nnf_forgery_get_item_id("fo", "littlepea");
var _upg_obj = nnf_forgery_get_item_id("fo", "littlepea_upgrade");

if (global.fo.littlepeas > 0 && !instance_exists(asset_get_index("obj_BMBG")) && IOCId != _reg_obj && IOCId != _upg_obj)
{
    var _coins_to_give = floor(HeldPrice / 2);
    nnf_give_coins(_coins_to_give);
    
    global.fo.littlepeas -= 1;
}
')